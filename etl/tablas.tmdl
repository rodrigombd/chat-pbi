			    FILTER(Calendario_2026, Calendario_2026[Date] IN VALUES(Calendario_2026[Date])), USERELATIONSHIP(Calendario_2026[Date], Leads_Contacts[Fecha creación]))
			RETURN IF(ISBLANK(cant_registros), 0, cant_registros)
			```
		lineageTag: d84aa600-daca-462c-ad6d-c1d21978a03d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Convertidos 2024' =
			
			VAR cant_registros = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Contacts",
			    Leads_Contacts[Curso] = "2024/2025",
			    Leads_Contacts[Particular o Grupo] = "Particular",
			    REMOVEFILTERS(Calendario_2026),  // Remueve el filtro aplicado por el slicer de Calendario_2023
			    REMOVEFILTERS(Calendario_2025),  // Remueve el filtro aplicado por el slicer de Calendario_2025
			    REMOVEFILTERS('Tabla_Ciudad_Interés'), // Remueve el filtro aplicado por el desplegable de Tabla_Ciudad_Interés
			    REMOVEFILTERS('Tabla_Residencia_Interés'), // Remueve el filtro aplicado por el desplegable de Tabla_Residencia_Interés
			    // Se utiliza el contexto del slicer de Calendario_2024
			    FILTER(Calendario_2024, Calendario_2024[Date] IN VALUES(Calendario_2024[Date])), USERELATIONSHIP(Calendario_2024[Date], Leads_Contacts[Fecha creación])
			)
			RETURN IF(ISBLANK(cant_registros), 0, cant_registros)
		formatString: 0
		lineageTag: b603360c-f5d9-4e36-b945-0154cf8e0813

	measure 'CR Convertidos 2025' =
			
			VAR cant_registros = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Contacts",
			    Leads_Contacts[Curso] = "2025/2026",
			    Leads_Contacts[Particular o Grupo] = "Particular",
			    REMOVEFILTERS(Calendario_2026),  // Remueve el filtro aplicado por el slicer de Calendario_2023
			    REMOVEFILTERS(Calendario_2024),  // Remueve el filtro aplicado por el slicer de Calendario_2024
			    REMOVEFILTERS('Tabla_Ciudad_Interés'), // Remueve el filtro aplicado por el desplegable de Tabla_Ciudad_Interés
			    REMOVEFILTERS('Tabla_Residencia_Interés'), // Remueve el filtro aplicado por el desplegable de Tabla_Residencia_Interés
			    // Se utiliza el contexto del slicer de Calendario_2025
			    FILTER(Calendario_2025, Calendario_2025[Date] IN VALUES(Calendario_2025[Date])), USERELATIONSHIP(Calendario_2025[Date], Leads_Contacts[Fecha creación])
			)
			RETURN IF(ISBLANK(cant_registros), 0, cant_registros)
		formatString: 0
		lineageTag: 6ab8e3ab-61b0-4a04-9c55-b0877457ae2d

	measure 'CR ConversionRate 2024' =
			
			var conversion_rate = DIVIDE([CR Convertidos 2024], [CR CantidadRegistros 2024],0)
			RETURN
			conversion_rate
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 4d9276af-4e40-4190-9c13-a83ea9134a03

	measure 'CR ConversionRate 2025' =
			
			var conversion_rate = DIVIDE([CR Convertidos 2025], [CR CantidadRegistros 2025],0)
			RETURN
			conversion_rate
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: d4b59fad-fa45-434f-b695-08d3cd444595

	measure 'LEADS Incremento' = [LEADS Seleccionados] - [LEADS Comparación]
		formatString: 0
		lineageTag: 1f686f3e-b9e4-4f07-84d3-cb1a867ff952

	measure 'CR Variación 2025vs2026' = [CR ConversionRate 2026] - [CR ConversionRate 2025]
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 3b06c1db-48e4-46e4-be81-5e0031ee8c9e

	measure 'CR Variación 2024vs2025' = [CR ConversionRate 2025] - [CR ConversionRate 2024]
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: b8e6f9a1-8e5c-4f3a-bbb3-71f59d2e2631

	measure 'GLOBAL CantidadRegistros' = ```
			
			VAR cant_registros = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Contacts",
			    Leads_Contacts[Particular o Grupo] = "Particular",
			    FILTER(Calendario, Calendario[Date] IN VALUES(Calendario[Date])), USERELATIONSHIP(Calendario[Date], Leads_Contacts[Fecha creación])
			)
			                + 
			            CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Leads",
			    FILTER(Calendario, Calendario[Date] IN VALUES(Calendario[Date]))
			)
			                RETURN IF(ISBLANK(cant_registros), 0, cant_registros)
			```
		formatString: #,0
		lineageTag: 8d36d909-50c8-46ac-b411-2cf881f2e5a7

	measure LEADS =
			
			VAR leads_var = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Leads",
			    REMOVEFILTERS(Tabla_Ciudad_Actual))
			RETURN IF(ISBLANK(leads_var), 0, leads_var)
		formatString: #,0
		lineageTag: 71d1840c-9f7b-45f0-907e-6ef4a1605370

	measure CONTACTS_Particular =
			
			VAR contacts_var = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Contacts",
			    Leads_Contacts[Particular o Grupo] = "Particular",
			    REMOVEFILTERS('Tabla_Ciudad_Interés'))
			RETURN IF(ISBLANK(contacts_var), 0, contacts_var)
		formatString: #,0
		lineageTag: 74098394-a2e5-4dbc-a767-682db369c0ab

	measure 'CONTACTS Previous Year' =
			
			VAR contacts_var_previous_year = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    Leads_Contacts[Tipo de registro] = "Contacts",
			    Leads_Contacts[Particular o Grupo] = "Particular", REMOVEFILTERS('Tabla_Ciudad_Interés'),
			    SAMEPERIODLASTYEAR(Calendario[Date]))
			RETURN IF(ISBLANK(contacts_var_previous_year), 0, contacts_var_previous_year)
		formatString: 0
		lineageTag: d03b6383-e11d-4648-81b2-d242187372f9

	measure 'CONTACTS % Variación_PreviousYear' = ```
			
			IF(
			    AND([CONTACTS_Particular] = 0, [CONTACTS Previous Year Dinámico] = 0),
			    "--",
			    IF(
			        [CONTACTS Previous Year Dinámico] = 0,
			        "--",
			        IF(
			            [CONTACTS_Particular] = 0,
			            "--",
			            DIVIDE([CONTACTS_Particular], [CONTACTS Previous Year Dinámico]) - 1
			        )
			    )
			)
			
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: e80d560d-6016-414d-bd21-2110f3331b22

	measure 'LEADS % Variación_PreviousYear' =
			
			IF(
			    AND([LEADS Seleccionados] = 0, [LEADS Previous Year Dinámico] = 0),
			    "--",
			    IF(
			        [LEADS Previous Year Dinámico] = 0,
			        "--",
			        IF(
			            [LEADS Seleccionados] = 0,
			            "--",
			            DIVIDE([LEADS Seleccionados], [LEADS Previous Year Dinámico]) - 1)))
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 9664b9e4-4caf-48c7-93a8-4799180843df

	measure 'LEADS Previous Year Dinámico' =
			
			VAR CursoSeleccionado = SELECTEDVALUE(Tabla_Curso[Curso])
			VAR AnioInicio = VALUE(LEFT(CursoSeleccionado, 4))
			VAR CursoAnterior =
			    FORMAT(AnioInicio - 1, "0000") & "/" &
			    FORMAT(AnioInicio, "0000")
			
			VAR Resultado =
			    CALCULATE(
			        DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			        Leads_Contacts[Tipo de registro] = "Leads",
			        REMOVEFILTERS(Tabla_Ciudad_Actual),
			        KEEPFILTERS(Tabla_Curso[Curso] = CursoAnterior)
			    )
			RETURN
			COALESCE(Resultado, 0)
		formatString: 0
		lineageTag: c69c3827-0b59-4dee-b21d-1f58ceaa5ba8

	measure 'CONTACTS Previous Year Dinámico' = ```
			
			VAR CursoSeleccionado = SELECTEDVALUE(Tabla_Curso[Curso])
			VAR AnioInicio = VALUE(LEFT(CursoSeleccionado, 4))
			VAR CursoAnterior = FORMAT(AnioInicio - 1, "0000") & "/" & FORMAT(AnioInicio, "0000")
			
			VAR contacts_var_previous_year = 
			    CALCULATE(
			        DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			        Leads_Contacts[Tipo de registro] = "Contacts",
			        Leads_Contacts[Particular o Grupo] = "Particular",
			        REMOVEFILTERS('Tabla_Ciudad_Interés'),
			        SAMEPERIODLASTYEAR(Calendario[Date]),
			        Tabla_Curso[Curso] = CursoAnterior
			    )
			RETURN IF(ISBLANK(contacts_var_previous_year), 0, contacts_var_previous_year)
			
			```
		formatString: 0
		lineageTag: 05b2c391-0205-4691-91ae-2fca5f8c3328

