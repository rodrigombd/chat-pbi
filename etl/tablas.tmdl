		annotation UnderlyingDateTimeDataType = Date

	column 'Mes creación'
		dataType: string
		lineageTag: c2b7db42-6507-4bb5-b979-8f935a82c0a2
		summarizeBy: none
		sourceColumn: Mes creación

		annotation SummarizationSetBy = Automatic

	column 'Mes y año creación'
		dataType: string
		lineageTag: d2681c7c-9289-4fd2-b1a0-adce4154813f
		summarizeBy: none
		sourceColumn: Mes y año creación

		annotation SummarizationSetBy = Automatic

	column Origen_Agrupado =
			
			VAR origen = 'Leads_Contacts'[Origen/Campaña Posibles Clientes]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(origen), "sin info",
			    origen IN {
			        "SEO & Directo",
			        "Paid Media",
			        "Ferias",
			        "Comisionistas",
			        "Eventos",
			        "Resa Housing"
			    }, origen,
			    "Otros"
			)
		lineageTag: e94af1fb-a8b6-4b1a-834e-6a53312f070b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Fuente_Agrupada =
			
			VAR fuente = 'Leads_Contacts'[Fuente de Posible Cliente]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(fuente), "Sin info",
			    CONTAINSSTRING(fuente, "Web Resa"), "Web Resa",
			    CONTAINSSTRING(fuente, "Unitour"), "Unitour",
			    fuente IN {
			        "Directo",
			        "Chat",
			        "Uniscopio",
			        "Contacto Residencia",
			        "Hello",
			        "Facebook"
			    }, fuente,
			    "Otros"
			)
		lineageTag: 8a990298-b456-46d1-acb0-482ade5c8a23
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Residencias_interes_corregido =
			
			IF(
			    ISBLANK(Leads_Contacts[Residencias de interés]) ||
			    TRIM(Leads_Contacts[Residencias de interés]) = "",
			    "Sin info",
			    Leads_Contacts[Residencias de interés]
			)
		lineageTag: 78393c5c-fa36-4edc-b56f-6825e512506d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Residencias_actual_corregido =
			
			IF(
			    ISBLANK(Leads_Contacts[Residencia actual]) ||
			    TRIM(Leads_Contacts[Residencia actual]) = "",
			    "Sin info",
			    Leads_Contacts[Residencia actual]
			)
		lineageTag: c37da539-5ab7-4750-a9fb-eee3fb939246
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ciudad_actual_corregido =
			
			IF(
			    ISBLANK(Leads_Contacts[Ciudad actual]) ||
			    TRIM(Leads_Contacts[Ciudad actual]) = "",
			    "Sin info",
			    Leads_Contacts[Ciudad actual]
			)
		lineageTag: 843cc173-088b-4e45-af1d-750517e1edbe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Ciudad_deinteres_corregido =
			
			VAR ciudadOriginal =
			    TRIM(Leads_Contacts[Ciudades de interés])
			RETURN
			IF(
			    ISBLANK(ciudadOriginal) || ciudadOriginal = "",
			    "Sin info",
			    IF(
			        CONTAINSSTRING(ciudadOriginal, "Miguel Antonio Caro") ||
			        CONTAINSSTRING(ciudadOriginal, "Orientadora"),
			        "Otros",
			        ciudadOriginal
			    )
			)
		lineageTag: d0b7d67c-4f11-4d6f-b51a-e5de7085818a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Curso_corregido =
			
			VAR CursoOriginal = TRIM(Leads_Contacts[Curso])
			RETURN
			IF(
			    ISBLANK(CursoOriginal) || CursoOriginal = "",
			    "Sin info",
			    SWITCH(
			        TRUE(),
			        CursoOriginal = "2024/2025", "2024/2025",
			        CursoOriginal = "2025/2026", "2025/2026",
			        CursoOriginal = "2026/2027", "2026/2027",
			        CursoOriginal = "2027/2028", "2027/2028",
			        "Otros cursos"
			    )
			)
		lineageTag: 8083ac6a-c83e-4c48-87b4-60a4c4276b85
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Leads_Contacts = m
		mode: import
		source = ```
				let
				    Origen = Table.Combine({Contacts_desktop, Leads_desktop}),
				    #"Valor reemplazado" = Table.ReplaceValue(Origen,"Ã±","ñ",Replacer.ReplaceText,{"Origen/Campaña Posibles Clientes"}),
				    Personalizado1 = Table.ReplaceValue(
				    Table.ReplaceValue(
				        Table.ReplaceValue(
				            Table.ReplaceValue(
				                Table.ReplaceValue(
				                    Table.ReplaceValue(
				                        Table.ReplaceValue(
				                            #"Valor reemplazado", 
				                            "Malaga", "Málaga", Replacer.ReplaceText, {"Ciudades de interés"}
				                        ), "Almeria", "Almería", Replacer.ReplaceText, {"Ciudades de interés"}
				                    ), "A Coruña", "La Coruña", Replacer.ReplaceText, {"Ciudades de interés"}
				                ), "La Coruna", "La Coruña", Replacer.ReplaceText, {"Ciudades de interés"}
				            ), "Sant Cugat del Valles", "Sant Cugat del Vallès", Replacer.ReplaceText, {"Ciudades de interés"}
				        ), "SanSebastián", "San Sebastián", Replacer.ReplaceText, {"Ciudades de interés"}
				    ), "Orense", "Ourense", Replacer.ReplaceText, {"Ciudades de interés"}
				),
				    #"Valor reemplazado1" = Table.ReplaceValue(Personalizado1,"Ã³","ó",Replacer.ReplaceText,{"Origen/Campaña Posibles Clientes"}),
				    #"Valor reemplazado2" = Table.ReplaceValue(#"Valor reemplazado1","ÃÂ","à",Replacer.ReplaceText,{"Origen/Campaña Posibles Clientes"}),
				    #"Valor reemplazado3" = Table.ReplaceValue(#"Valor reemplazado2","Ã­","í",Replacer.ReplaceText,{"Origen/Campaña Posibles Clientes"}),
				    #"Valor reemplazado4" = Table.ReplaceValue(#"Valor reemplazado3","Cita Previa","Cita previa",Replacer.ReplaceValue,{"Origen/Campaña Posibles Clientes"}),
				    #"Valor reemplazado5" = Table.ReplaceValue(#"Valor reemplazado4","Ã¡","á",Replacer.ReplaceText,{"Origen/Campaña Posibles Clientes"}),
				    #"Valor reemplazado6" = Table.ReplaceValue(#"Valor reemplazado5","Ã³","ó",Replacer.ReplaceText,{"Fuente de Posible Cliente"}),
				    #"Valor reemplazado7" = Table.ReplaceValue(#"Valor reemplazado6","Ã¡","á",Replacer.ReplaceText,{"Fuente de Posible Cliente"}),
				    #"Valor reemplazado8" = Table.ReplaceValue(#"Valor reemplazado7","Ã©","é",Replacer.ReplaceText,{"Fuente de Posible Cliente"}),
				    #"Valor reemplazado9" = Table.ReplaceValue(#"Valor reemplazado8","Malaga","Málaga",Replacer.ReplaceText,{"Residencia escogida"}),
				    #"Valor reemplazado10" = Table.ReplaceValue(#"Valor reemplazado9",null,"---",Replacer.ReplaceValue,{"Residencia escogida"}),
				    #"Valor reemplazado11" = Table.ReplaceValue(#"Valor reemplazado10","Ninguno","---",Replacer.ReplaceValue,{"Residencia escogida"}),
				    #"Valor reemplazado12" = Table.ReplaceValue(#"Valor reemplazado11",null,"---",Replacer.ReplaceValue,{"Residencia actual"}),
				    #"Valor reemplazado13" = Table.ReplaceValue(#"Valor reemplazado12",null,"---",Replacer.ReplaceValue,{"Ciudad actual"}),
				    #"Valor reemplazado14" = Table.ReplaceValue(#"Valor reemplazado13","Ramon","Ramón",Replacer.ReplaceText,{"Residencia actual"}),
				    #"Columna mes" = Table.AddColumn(#"Valor reemplazado14", "Mes creación", each Date.Month([Fecha creación])),
				    #"Columna mes/año" = Table.AddColumn(#"Columna mes", "Mes y año creación", each Date.ToText([Fecha creación], "MM-yyyy"))
				in
				    #"Columna mes/año"
				```

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación



