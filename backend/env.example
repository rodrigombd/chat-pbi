# Copia a .env (no lo subas a git) y rellena los valores.
# En PowerShell:  $env:OPENAI_API_KEY = "sk-..."

OPENAI_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
EMBEDDING_MODEL=text-embedding-3-small
ORCHESTRATOR_MODEL=gpt-4o
NEO4J_VECTOR_INDEX=resa_concept_embeddings
SUBGRAPH_DEPTH=2
