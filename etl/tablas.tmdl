Calendario.tmdl
table Calendario
	lineageTag: 4899248f-5b4c-41fc-857b-6b52dba17aee

	column Date
		formatString: Short Date
		lineageTag: 384ddd97-5ef6-40ec-b0b6-e0492b8cb122
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variación
			isDefault
			relationship: 4d56a21e-aa3d-4615-852e-cb422286e485
			defaultHierarchy: LocalDateTable_88551266-b59e-4066-8920-7b476f7d9dcd.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column Año
		formatString: 0
		lineageTag: ae2d1da4-3d89-4744-bbb0-09d98d610b7e
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column Mes
		formatString: 0
		lineageTag: 4e531ab5-9363-4bf0-9c59-60aa24470337
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column NombreMes
		lineageTag: 8f4d1efb-56cf-42b9-9afa-111a20f5fb5b
		summarizeBy: none
		isNameInferred
		sourceColumn: [NombreMes]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		formatString: 0
		lineageTag: 7d60db31-15cd-4e6a-b9f6-3e705affabf2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column Semana
		formatString: 0
		lineageTag: 952f3a22-4644-4577-8a1b-4198f252b476
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Semana]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				
				VAR FechaInicio = DATE(YEAR(MIN(Leads_Contacts[Fecha creación])), 1, 1)
				VAR FechaFin = DATE(YEAR(MAX(Leads_Contacts[Fecha creación])), 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(FechaInicio, FechaFin),
				    "Año", YEAR([Date]),
				    "Mes", MONTH([Date]),
				    "NombreMes", FORMAT([Date], "MMMM"),
				    "Trimestre", QUARTER([Date]),
				    "Semana", WEEKNUM([Date])
				)

	annotation PBI_Id = b5994b09cc9f45e89c333442533cab2b



