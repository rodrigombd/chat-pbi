Medidas Calculadas.tmdl
table 'Medidas calculadas'
	lineageTag: 23a496f6-0a1c-4111-922f-cea7798e2f72

	measure 'LEADS Seleccionados' = ```
			
			VAR lead_var = CALCULATE(
			    DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			    FILTER(Calendario, Calendario[Date] IN VALUES(Calendario[Date])), Leads_Contacts[Tipo de registro] = "Leads" 
			)
			RETURN IF(ISBLANK(lead_var), 0, lead_var)
			```
		formatString: #,0
		lineageTag: 05ef8a13-9c66-498d-a743-47e29e442500

	measure 'LEADS Comparación' = ```
			
			var lw_var = CALCULATE(
			                DISTINCTCOUNT(Leads_Contacts[Correo electrónico]),
			                FILTER(
			                    ALL(Calendario[Date]),  
			                    Calendario[Date] >= MIN(Calendario_Comparacion[Date_COMPARACION]) &&
			                    Calendario[Date] <= MAX(Calendario_Comparacion[Date_COMPARACION])
			                ),
			                Leads_Contacts[Tipo de registro] = "Leads"
			            )
			RETURN
			IF(ISBLANK(lw_var),0,lw_var)
			
			```
		formatString: #,0
		lineageTag: 3b8c8fa4-9677-4300-ad35-662cb6a01f38

	measure 'LEADS Incremento 2026vs2025' = [LEADS 2026] - [LEADS 2025]
		formatString: 0
		lineageTag: 090b64b7-10e5-43ac-b9e2-2b72b801d2bc

	measure 'LEADS % Variación_2Fechas' = ```
			
			IF(AND([LEADS Seleccionados] = 0, [LEADS Comparación] = 0),"--",
			    IF([LEADS Comparación] = 0, "--",
			        IF([LEADS Seleccionados] = 0, "--",
			            DIVIDE([LEADS Seleccionados], [LEADS Comparación]) - 1)))
			
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
